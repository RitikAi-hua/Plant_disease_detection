# FastAPI base URL (no trailing slash)
VITE_API_URL=http://127.0.0.1:8000

# Update this to the prediction route defined in your FastAPI app.
VITE_PREDICT_PATH=/predict

# Optional: set to the exact upload field your FastAPI endpoint expects.
# Common examples are "file" or "image", but check your endpoint first.
VITE_UPLOAD_FIELD=file
